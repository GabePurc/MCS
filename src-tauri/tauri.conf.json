{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCS Microcontroller Simulator",
  "version": "0.1.0",
  "identifier": "com.gabepurcell.mcs",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "MCS - Microcontroller Simulator",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "backgroundColor": "#cbd8e8"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Microcontroller simulator (ATtiny10 first)",
    "longDescription": "Cycle-accurate microcontroller simulator with assembler, C toolchain integration and a Windows 7 style debugger UI.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Gabe Purcell",
    "copyright": "Copyright (c) 2026 Gabe Purcell. MIT License.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
